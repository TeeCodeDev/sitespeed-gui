# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Storage & Database (inside container)
DB_PATH=/data/db/sitespeed.sqlite
RESULTS_DIR=/data/results

# Docker Runner (Linux Docker socket)
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Name of the shared Docker volume mounted at RESULTS_DIR in both this app and sitespeed.io containers
RESULTS_VOLUME_NAME=sitespeed_results
SITESPEED_IMAGE=sitespeedio/sitespeed.io:latest
MAX_CONCURRENT_RUNS=1
RUN_TIMEOUT_MS=300000
CONTAINER_MEMORY_MB=2048
CONTAINER_SHM_MB=1024
CONTAINER_CPU_CORES=2

# Security
# Set to true only if you intentionally test internal/staging URLs on private LAN IPs
ALLOW_PRIVATE_NETWORKS=false
# Optional Basic Auth for internal LAN/VPN protection (leave empty to disable)
AUTH_USERNAME=
AUTH_PASSWORD=
CORS_ORIGIN=*
